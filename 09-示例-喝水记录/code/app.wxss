/* ============================================================
 * 喝水记录示例 · app.wxss
 * 数值全部来自 08-设计参考/02-设计token.md，没有自创尺寸。
 * 注意：WXSS 不支持 CSS 变量，所以这里是字面值，不是 var(--x)。
 * ============================================================ */

/* ---------- 基础重置 ---------- */
page {
  background: #F5F6F8;
  color: #1A1A1A;
  font-size: 28rpx;
  line-height: 1.55;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view { box-sizing: border-box; }

/* 页面容器：统一左右边距 32rpx。
   刻意不叫 .page —— 全局 .page 在别人的项目里常带负边距，只给沉浸式页面用。
   换个项目复制这段样式时，先搜一下有没有同名类。 */
.np {
  min-height: 100vh;
  padding-top: 24rpx;
}

.page-pad { padding-left: 32rpx; padding-right: 32rpx; }

/* ---------- 排版 ---------- */
.t-display  { font-size: 52rpx; line-height: 1.25; font-weight: 700; }
.t-title    { font-size: 40rpx; line-height: 1.3;  font-weight: 600; }
.t-subtitle { font-size: 36rpx; line-height: 1.35; font-weight: 600; }
.t-body     { font-size: 28rpx; line-height: 1.55; }
.t-caption  { font-size: 24rpx; line-height: 1.5;  color: #8A8A8A; }

.c-brand  { color: #1989FA; }
.c-sub    { color: #5A5A5A; }
.c-danger { color: #EE0A24; }

/* ---------- 布局 ---------- */
.row    { display: flex; align-items: center; }
.row-sb { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; min-width: 0; }

/* ---------- 卡片 ---------- */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.card + .card { margin-top: 24rpx; }

/* ---------- 按钮 ---------- */
.btn-primary {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #1989FA;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  padding: 0;
}
.btn-hover { opacity: 0.85; }
button::after { border: none; }

/* ---------- 首页 ---------- */
.head { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 24rpx; }

.streak {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #E8F2FE;
  color: #1989FA;
  font-size: 24rpx;
}

.hero { padding: 40rpx 32rpx 32rpx; }

.hero-num { display: flex; align-items: baseline; }
.hero-unit { font-size: 28rpx; color: #8A8A8A; margin-left: 12rpx; }

.bar {
  height: 16rpx;
  border-radius: 999rpx;
  background: #EDEDED;
  margin-top: 24rpx;
  overflow: hidden;
}
.bar-fill {
  height: 16rpx;
  border-radius: 999rpx;
  background: #1989FA;
  transition: width 0.3s ease;
}

.hero-hint { margin-top: 16rpx; }

.main-btn { margin-top: 32rpx; }

.quick { display: flex; gap: 16rpx; margin-top: 16rpx; }

.chip {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDEDED;
  color: #5A5A5A;
  font-size: 26rpx;
}

.section-title { margin: 48rpx 0 16rpx; }

.link { font-size: 26rpx; color: #1989FA; padding: 8rpx 0 8rpx 24rpx; }

.list { padding-top: 8rpx; padding-bottom: 8rpx; }

.item { padding: 20rpx 0; border-bottom: 1rpx solid #EDEDED; }
.item:last-child { border-bottom: none; }

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #1989FA;
  margin-right: 20rpx;
}

.empty { text-align: center; padding: 56rpx 32rpx; }
.empty-title { font-size: 30rpx; color: #5A5A5A; margin-bottom: 8rpx; }

.tip { margin: 40rpx 0 48rpx; line-height: 1.6; }

/* ---------- 记录页 ---------- */
.chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 240rpx;
  margin-top: 24rpx;
}

.chart-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}

.chart-bar {
  width: 28rpx;
  border-radius: 999rpx;
  background: #D6E7FD;
  min-height: 8rpx;
}
.chart-bar.is-today { background: #1989FA; }

.day-label { margin-top: 12rpx; font-size: 20rpx; color: #8A8A8A; }
.day-label.is-today { color: #1989FA; }

.group { margin-top: 24rpx; }

.group-head { padding: 8rpx 0 16rpx; }

.row-item { padding: 24rpx 0; border-bottom: 1rpx solid #EDEDED; }
.row-item:last-child { border-bottom: none; }

.amount { font-size: 32rpx; font-weight: 600; }

/* ---------- 我的 ---------- */
.field { padding: 28rpx 0; border-bottom: 1rpx solid #EDEDED; }
.field:last-child { border-bottom: none; }

.field-label { font-size: 30rpx; }
.field-value { font-size: 28rpx; color: #8A8A8A; }

.goal-value { font-size: 30rpx; color: #1989FA; font-weight: 600; }

.divider { height: 1rpx; background: #EDEDED; margin: 8rpx 0; }

.about { margin-top: 40rpx; line-height: 1.7; }
